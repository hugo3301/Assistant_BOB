{
  "name": "assistant-bob",
  "version": "0.2.0-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs experiments/workers-ai/tests/*.test.mjs",
    "chat": "node --env-file-if-exists=.env scripts/chat.mjs",
    "demo": "node scripts/demo.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "test:cloud": "node scripts/build-cloud.mjs && node scripts/check-cloud-local.mjs",
    "deploy": "node --env-file=.env scripts/deploy.mjs",
    "design:catalog": "node scripts/render-design-catalog.mjs docs/design-catalog.html",
    "check:repo": "node scripts/check-repository.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "ci": "npm run check:repo && npm test && npm run test:cloud"
  },
  "dependencies": {
    "ical.js": "2.2.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "miniflare": "5.20261103.0-beta",
    "wrangler": "4.160.0"
  },
  "description": "Личный Telegram-помощник: задачи, встречи, расписание и напоминания",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugo3301/Assistant_BOB.git"
  },
  "bugs": {
    "url": "https://github.com/hugo3301/Assistant_BOB/issues"
  },
  "homepage": "https://github.com/hugo3301/Assistant_BOB#readme"
}
