# Local development. Copy to .env; never commit real values.
# For a separate deployment, also change account_id/name in wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEPLOY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_SECRET_KEY=
GROQ_API_KEY=
GROQ_ENABLED=false
GROQ_FREE_CONFIRMED=false
# Node bridge only: never upload GIGACHAT_AUTH_KEY to the Worker.
GIGACHAT_AUTH_KEY=
GIGACHAT_RELAY_URL=
GIGACHAT_RELAY_SECRET=
GIGACHAT_ENABLED=false
GIGACHAT_FREE_CONFIRMED=false
GIGACHAT_PUBLIC_USE_CONFIRMED=false
GIGACHAT_TRANSPORT_VERIFIED=false
GIGACHAT_EVALUATED=false
GIGACHAT_TOKEN_CAP=0
